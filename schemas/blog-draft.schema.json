{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "content_html",
    "labels",
    "summary",
    "fact_check_notes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content_html": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "summary": {
      "type": "string"
    },
    "fact_check_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}