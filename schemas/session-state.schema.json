{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Electron-S/photo-blog-agent/schemas/session-state.schema.json",
  "$comment": "문서·외부 도구용 참조 스키마입니다. 런타임 검증에는 쓰이지 않습니다 — lib/session-state.js의 손수 검증이 진실의 출처이고, 이 저장소에는 JSON Schema 검증 라이브러리(ajv 등)가 없습니다. 두 곳을 함께 갱신하세요.",
  "title": "photo-blog-agent session state",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "slug", "steps_completed", "steps_remaining", "last_updated"],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "$comment": "파일 경로 tmp/session-state-<slug>.json 에 그대로 들어가므로 경로 traversal을 막는다."
    },
    "primary_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "$comment": "EXIF 촬영 날짜. 글 작성 시점이 아니다."
    },
    "steps_completed": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["exif", "photo_analysis", "upload", "research", "draft", "publish"] }
    },
    "steps_remaining": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["exif", "photo_analysis", "upload", "research", "draft", "publish"] },
      "$comment": "steps_completed로부터 항상 재계산된다. 두 배열은 전체 단계 목록의 완전한 분할이다."
    },
    "unknown_steps": {
      "type": "array",
      "items": { "type": "string" },
      "$comment": "옛 파일에 있던 알 수 없는 단계 이름을 격리해 둔 곳. 데이터를 잃지 않기 위함."
    },
    "metadata_path": { "type": ["string", "null"] },
    "analysis_path": { "type": ["string", "null"] },
    "upload_result_path": { "type": ["string", "null"] },
    "draft_path": { "type": ["string", "null"] },
    "post_id": { "type": ["string", "null"] },
    "post_url": { "type": ["string", "null"] },
    "last_updated": {
      "type": ["string", "null"],
      "$comment": "KST ISO 8601 (예: 2026-05-10T14:23:00+09:00)"
    }
  }
}
