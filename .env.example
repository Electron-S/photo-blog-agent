# Blogger API
BLOGGER_BLOG_ID=109669205162281399
BLOGGER_CLIENT_ID=your_google_oauth_client_id_here
BLOGGER_CLIENT_SECRET=your_google_oauth_client_secret_here
BLOGGER_REFRESH_TOKEN=your_google_oauth_refresh_token_here

# GitHub Pages image hosting
GITHUB_OWNER=Electron-S
GITHUB_ASSET_REPO=photo-blog-assets
GITHUB_ASSET_BRANCH=main
GITHUB_ASSET_BASE_URL=https://electron-s.github.io/photo-blog-assets
# 비워두면 gh auth token을 사용합니다.
GITHUB_TOKEN=

# Image watermark (optional, defaults to electronian-review.blogspot.com)
WATERMARK_TEXT=

# Naver Blog (네이버 블로그) — 실험적, 현재 미검증
# 로그인 자격증명은 .env에 저장하지 않습니다. npm run naver:login으로 대화형 로그인 후
# .naver-profile/ (chromium 영속 프로필)에 세션이 유지됩니다.
#
# 필수: 에디터 URL, 로그인 계정 검증, 발행 후 URL 대조에 모두 씁니다.
# blog.naver.com/{여기} 의 블로그 아이디.
NAVER_BLOG_ID=

# 선택: chromium 프로필 디렉터리 (기본값: .naver-profile)
NAVER_PROFILE_DIR=

# 안전장치: 공개 발행을 하려면 1로 설정해야 합니다.
# --visibility public 플래그만으로는 공개 발행이 거부됩니다 (오타/복붙 사고 방지).
NAVER_ALLOW_PUBLIC=
